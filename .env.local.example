# このキーはブラウザーへ渡ります。参加者用の実験キーを使います。
VITE_SUBAKO_API_KEY=
VITE_SUBAKO_BASE_URL=https://api.us.cloud.subako.ai

# agent:models の結果から運営が指定した値を入れます。
SUBAKO_MODEL_PROVIDER_ID=
SUBAKO_MODEL_ID=
SUBAKO_MODEL_FORMAT=
# CLIのconfig-exampleと同じ初期値。運営指定があれば変更します。
SUBAKO_MODEL_CONTEXT_WINDOW=128000

# 任意：外部プレビューのOrigin。パスや末尾の / は付けません。
SUBAKO_EXTRA_ORIGINS=

# 以下は publish / session:new が更新します。
VITE_SUBAKO_SESSION_TODO=
VITE_SUBAKO_SESSION_TODO_INTEGRATED=
VITE_SUBAKO_SESSION_MAP=
VITE_SUBAKO_SESSION_MAP_COFFEE=
VITE_SUBAKO_SESSION_EC=
VITE_SUBAKO_SESSION_EC_COFFEE=
